# Server
NODE_ENV=development
PORT=8800
CLIENT_ORIGIN=http://localhost:5173

# MySQL (the dbms-mysql container published on 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=campus-community

# Auth — generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=access_token
# Leave unset behind HTTPS. Set to false when serving over plain HTTP (the
# Docker stack does this for localhost).
# COOKIE_SECURE=false

# Uploads
UPLOAD_MAX_MB=5

# Brute-force protection on /api/auth/login and /api/auth/register
AUTH_RATE_LIMIT=100
AUTH_RATE_WINDOW_MINUTES=15
