{
  "name": "blog-site",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack blog app — React + Node/Express + MySQL",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace src/backend",
    "dev:web": "npm run dev --workspace src/frontend",
    "db:init": "npm run db:init --workspace src/backend",
    "db:migrate": "npm run db:migrate --workspace src/backend",
    "build": "npm run build --workspace src/frontend"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.2"
  }
}
