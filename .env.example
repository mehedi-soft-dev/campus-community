# Optional overrides for docker-compose.yml.
#
# Compose reads a file named `.env` from this directory automatically. Nothing
# here is required — the values below are the built-in defaults, shown so they
# are easy to change. Copy to `.env` only if you need different values.

# MySQL root password, also used by the API to connect.
DB_PASSWORD=root

# Database name.
DB_NAME=campus-community

# Signing key for auth tokens. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-replace-before-deploying-2f8c1a9d
